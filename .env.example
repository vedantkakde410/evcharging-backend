# Turn these into real environment variables (shell export, your IDE's run
# configuration, or your host's environment/secrets settings) - Spring Boot
# does not read a .env file automatically, copying this to .env alone does
# nothing. Never commit a real .env with actual secrets; only this
# .env.example template is checked in.

# ========== Server ==========
# Most hosts (e.g. Railway) set this automatically - leave unset locally to
# fall back to 8801.
PORT=8801

# ========== Database (MySQL) ==========
DB_URL=jdbc:mysql://localhost:3306/ev_charging_system
DB_USERNAME=root
# Required - no default. Set to your local MySQL root password for dev, or
# the DB credentials your host provides in production.
DB_PASSWORD=

# ========== JWT ==========
# Required in any shared/production deployment - a long, random, secret
# string (e.g. `openssl rand -base64 48`). If unset, the app falls back to
# a dev-only value that is NOT safe outside a single developer's machine
# (see application.properties).
JWT_SECRET=
JWT_ACCESS_EXPIRY_MS=86400000
JWT_RESET_EXPIRY_MS=600000

# ========== Mail (OTP delivery) ==========
# Defaults target MailHog (https://github.com/mailhog/MailHog) on
# localhost:1025 for local dev - mail sent there is caught, not delivered,
# viewable at http://localhost:8025. Point at a real SMTP provider (Gmail
# with an App Password, SendGrid, Mailgun, etc.) for real delivery.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@evcharge.local

# ========== CORS ==========
# Comma-separated allowed origins. Defaults to "*" (matches this app's
# existing behavior) - set to the real frontend URL(s) in production, e.g.
# https://evcharge.vercel.app
CORS_ALLOWED_ORIGINS=*
